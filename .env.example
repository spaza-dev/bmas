BMAS_CONFIG=/etc/bmas/config.toml
RUST_LOG=info,bmas=debug

# Required by config.toml. Generate with: openssl rand -hex 32
BMAS_API_TOKEN=REPLACE_WITH_SECURE_TOKEN

# Identifier for this node. Central uses it to correlate storage manifests.
BMAS_NODE_ID=

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO, B2, ...)
BMAS_STORAGE_ACCOUNT_ID=
BMAS_STORAGE_ACCESS_KEY_ID=
BMAS_STORAGE_SECRET_ACCESS_KEY=
BMAS_STORAGE_BUCKET=
BMAS_STORAGE_ENDPOINT_URL=
