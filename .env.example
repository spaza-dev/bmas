BMAS_CONFIG=/etc/bmas/config.toml
RUST_LOG=info,bmas=debug

# Required by config.toml. Generate with: openssl rand -hex 32
BMAS_API_TOKEN=REPLACE_WITH_SECURE_TOKEN

# UUID of this node in the central API (required when [central] enabled = true)
BMAS_NODE_ID=

# Cloudflare R2
BMAS_R2_ACCOUNT_ID=
BMAS_R2_ACCESS_KEY_ID=
BMAS_R2_SECRET_ACCESS_KEY=
BMAS_R2_BUCKET=
BMAS_R2_ENDPOINT_URL=

# Central API node token (when [central] enabled = true)
BMAS_CENTRAL_NODE_TOKEN=
