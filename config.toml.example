[node]
id = "${BMAS_NODE_ID}"
listen = "127.0.0.1:8787"
data_dir = "/var/lib/bmas"
api_token = "${BMAS_API_TOKEN}"
max_concurrent_streams = 8
reconnect_delay_seconds = 5
keep_local_chunks = false
allowed_origins = []

[recording]
ffmpeg_path = "/usr/bin/ffmpeg"
ffprobe_path = "/usr/bin/ffprobe"
olaf_path = "/usr/local/bin/olaf"

chunk_seconds = 300
sample_rate = 16000
archive_audio = true
ffprobe_timeout_seconds = 60
olaf_timeout_seconds = 900
stall_timeout_seconds = 600

[indexing]
threads = 2
workers = 2
max_retries = 5

# S3-compatible archive storage. backend = "r2" derives the Cloudflare
# endpoint from account_id when endpoint_url is empty. Use backend = "s3"
# for AWS S3, MinIO, Backblaze B2, etc.
[storage]
enabled = true
backend = "r2"
account_id = "${BMAS_STORAGE_ACCOUNT_ID}"
endpoint_url = "${BMAS_STORAGE_ENDPOINT_URL}"
region = "auto"
bucket = "${BMAS_STORAGE_BUCKET}"
prefix = "archives"
access_key_id = "${BMAS_STORAGE_ACCESS_KEY_ID}"
secret_access_key = "${BMAS_STORAGE_SECRET_ACCESS_KEY}"
# force_path_style = true

[limits]
min_free_gb = 2
max_enabled_streams = 8
work_retention_hours = 24
local_retention_days = 0
